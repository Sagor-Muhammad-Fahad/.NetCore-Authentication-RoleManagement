@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

<div class="container mt-4">

    <h2>Role Management</h2> <hr />

    <div class="card mt-4">
        <div class="card-header bg-primary text-white">Create New Role</div>
        <div class="card-body">
            <form asp-action="CreateRole" method="post" class="row g-3">
                <div class="col-auto">
                    <input type="text" name="roleName" class="form-control" placeholder="Enter Role" required/>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Add Role</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-dark text-white">Existing Roles</div>
        <div class="card-body">

            <table class="table table-bordered tab-hover">
                <thead>
                    <tr>
                        <th>Role Id</th>
                        <th>Role Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any()){
                        foreach (var role in Model)
                        {
                            <tr>
                                <td>@role.Id</td>
                                <td>@role.Name</td>
                                <td class="text-end">
                                    <form asp-action="DeleteRole" asp-route-id="@role.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this @role.Name')">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>

                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3">No role created yet...</td>
                        </tr>
                    }
                </tbody>

                </table>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </div>
    </div>