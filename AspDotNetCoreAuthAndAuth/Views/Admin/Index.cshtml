@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
<h2>Admin Panel - Users</h2>

<table>
    <thead>
        <tr>
            <th>User</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach(var user in Model)
        {
            <tr>
                <td>
                    @user.Email
                </td>

                <td>
                    <a asp-action="ManageUserRoles" asp-route-userId="@user.Id" class="btn btn-sm btn-primary">Manage Roles</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="ListOfRoles" class="btn btn-secondary">Manage Role List</a>